# Copie para .env e preencha. Nunca versione o .env.

# --- Obrigatórias em produção ---
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Postgres (Supabase). Sem isso o sistema usa SQLite local.
DATABASE_URL=

# --- URL pública do frontend (links de e-mail e CORS) ---
APP_URL=https://seu-projeto.vercel.app
# Outras origens autorizadas a chamar a API com cookies (separadas por vírgula)
CORS_ORIGINS=

# --- Upload de arquivos (obrigatório em produção; sem isso só funciona localmente) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=uploads

# --- E-mail (SMTP) ---
MAIL_SERVER=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
